# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Юзернейм бота (без @)
BOT_USERNAME=SpectrMindBot

# ID канала (публичный SpectrMind)
# Для публичного канала: @spectrmind_channel (username без @)
CHANNEL_ID=@spectrmind_channel

# Ссылка на канал (для кнопки в боте)
CHANNEL_LINK=https://t.me/spectrmind_channel

# Путь к PDF-гайду (лежит в корне проекта)
PDF_PATH=neuro_stack.pdf

# Telegram ID админов (через запятую, без пробелов)
ADMIN_IDS=123456789

# Ссылка на оплату закрытого канала (Robokassa)
# После оплаты Robokassa редиректит на инвайт-ссылку канала (настраивается в Robokassa)
PAID_CHANNEL_LINK=https://auth.robokassa.ru/Merchant/Index/056755a6-4241-1058-6b63-cd33618e525c
PAID_CHANNEL_PRICE=990₽

# Ссылка на оплату полного нейрогайда (ЮKassa/Robokassa)
NEUROGUIDE_LINK=https://spectrmind.ru/neuroguide
NEUROGUIDE_PRICE=1990₽

# OpenRouter API Key (получить на https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Модель через OpenRouter (бесплатные модели отмечены :free)
# Все бесплатные: https://openrouter.ai/models?q=free
# Рекомендации (бесплатные, pricing = 0):
#   google/gemma-4-31b-it:free              — Gemma 4 31B (лучший русский, dense)
#   nvidia/nemotron-3-ultra-550b-a55b:free  — Nemotron 3 Ultra (550B, самая мощная)
#   nvidia/nemotron-3-super-120b-a12b:free  — Nemotron 3 Super (120B, баланс)
#   openai/gpt-oss-20b:free                 — OpenAI open-source (21B)
MODEL=google/gemma-4-31b-it:free

# Часовой пояс (МСК = Europe/Moscow)
TIMEZONE=Europe/Moscow

# Время публикации утреннего поста (микро-протокол)
MORNING_POST_HOUR=8
MORNING_POST_MINUTE=0

# Время публикации вечернего поста (исследование)
EVENING_POST_HOUR=19
EVENING_POST_MINUTE=0
